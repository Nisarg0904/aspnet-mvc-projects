@model Project
@{
    //razor block
    ViewData["Title"] = "Project Details";


}
@{
    <div class="card" style="width: 28rem;">
        <div class="card-body">
            <h4 class="card-title">@Model.ProjectId @Model.Name    </h4>
            <h5 class="card-subtitle mb-2 text-body-secondary">@Model.Status</h5>
            <h6 class="card-subtitle mb-2 text-body-secondary">@Model.StartDate.ToShortDateString() --> @Model.EndDate.ToShortDateString()</h6>
            <h6 class="card-subtitle mb-2 text-body-secondary">@Model.Status</h6>
    <p class="card-text">@Model.Description</p>
            <a class="btn btn-primary" asp-controller="Project" asp-action="Edit" asp-route-id=@Model.ProjectId><i class="fa-regular fa-pen-to-square"></i></a>

  </div>
</div>
<br />
    <a class="btn btn-secondary" asp-controller="Project" asp-action="Index">Go back</a>

}
