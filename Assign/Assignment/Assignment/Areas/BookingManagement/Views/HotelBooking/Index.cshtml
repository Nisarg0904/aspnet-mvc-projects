@using Assignment.Areas.BookingManagement.Models;
@using Assignment.Areas.ServiceManagement.Models;
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@model List<Hotel>

<!DOCTYPE html>
<html>
<head>
    <title>Hotel Search</title>
</head>
<body>
    @if (Model.Any())
    {
        <form class="d-flex" asp-controller="HotelBooking" asp-action="HotelSearch" method="get">
            <input class="form-control" type="text" placeholder="Search" name="searchString" />
            <select class="form-control btn btn-secondary dropdown-toggle" name="searchType">
                <option value="Name">Name</option>
                <option value="City">City</option>
            </select>
            <button class="btn btn-outline-success" type="submit">Search</button>
        </form>

        <form asp-action="Create" method="get">
            <div class="form-group">
                <label for="City">City:</label>
                <select class="form-control" id="City" name="City">
                    @foreach (var city in Model.Select(h => h.city).Distinct())
                    {
                        <option>@city</option>
                    }
                </select>
    </div>
    <div class="form-group">
        <label for="numRooms">Number of Rooms:</label>
        <input class="form-control" id="numRooms" type="number" name="numRooms"  required/>
    </div>

        <br />

        <button type="submit" class="btn btn-primary">Search</button>
            <a asp-action="Index" asp-controller="Booking" class="btn btn-secondary">Cancel</a>

        </form>
        

    }
    else
    {
        <p>No Hotel Available.</p>
        <br />
        <a asp-action="Index" asp-controller="Booking" class="btn btn-secondary">Cancel</a>

    }
</body>
</html>
