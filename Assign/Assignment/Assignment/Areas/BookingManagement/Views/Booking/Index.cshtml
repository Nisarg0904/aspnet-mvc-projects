@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

<div class="d-flex justify-content-center align-items-center" style="height: 100vh;">
    <div class="text-center">
        <a asp-action="Create" class="btn btn-primary" style="font-size: 2.5rem; padding: 10px; width: 150px; margin-right: 45px;">
            <div style="background-color: white; display: inline-block; padding: 5px; border-radius: 50%;">🌎</div>
            <div class="small">Create</div>
        </a>

        @if (User.Identity.IsAuthenticated)
        {
            <a asp-action="SDetails" class="btn btn-primary" style="font-size: 2.5rem; padding: 10px; width: 150px;">
                <div style="background-color: white; display: inline-block; padding: 5px; border-radius: 50%;">🔭</div>
                <div class="small">Browse</div>
            </a>
        }
        else
        {
            <a asp-action="Details" class="btn btn-primary" style="font-size: 2.5rem; padding: 10px; width: 150px;">
                <div style="background-color: white; display: inline-block; padding: 5px; border-radius: 50%;">🔭</div>
                <div class="small">Browse</div>
            </a>
        }
    </div>
</div>
