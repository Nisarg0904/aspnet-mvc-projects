@using Assignment.Areas.BookingManagement.Models;
@using Assignment.Areas.ServiceManagement.Models;

@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@model CarBooking

@{
    ViewData["Title"] = "Delete Car Booking";
}
@if (Model != null)
    {
        <h2>Are You Sure You Want To Delete This Car Booking?</h2>

      
            var carBooking = Model as CarBooking;

            <p>Booking ID: @carBooking.booking.id</p>
            <p>Booking Date: @carBooking.booking.date.ToString("yyyy-MM-dd")</p>

            <h3>Car Details</h3>
            <p>Car Model: @carBooking.car.model</p>
            <p>Type: @carBooking.car.type</p>
            <p>Price: $@carBooking.booking.price</p>
            <p>Rental Company: @carBooking.car.rentalCompanies</p>
            <p>Location: @carBooking.car.location</p>
            <p>Pickup Date: @carBooking.bookedFrom.ToString("yyyy-MM-dd")</p>
            <p>Return Date: @carBooking.bookedTo.ToString("yyyy-MM-dd")</p>
            <form asp-action="DeleteCBooking" asp-controller="Booking" method="post" style="display: inline;">
                <input type="hidden" name="bookingId" value="@carBooking.booking.id" />
                <button type="submit" class="btn btn-danger">Confirm</button>
            </form>
    <a href="javascript:history.back()" class="btn btn-secondary">No</a>

    }