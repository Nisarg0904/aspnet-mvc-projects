@using Assignment.Areas.BookingManagement.Models;
@using Assignment.Areas.ServiceManagement.Models;
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@using Microsoft.AspNetCore.Identity
@using Microsoft.VisualStudio.Web.CodeGenerators.Mvc.Templates.BlazorIdentity.Pages.Manage
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

<!DOCTYPE html>
<html>
<head>
    <title>Booking Details</title>
    <style>
        form {
            text-align: center;
        }

        #bookingType, #bookingId {
            width: 50%;
            margin-left: 25%;
        }

        h2 {
            margin-top: 30px;
            margin-bottom: 100px;
            font-family: 'Merriweather', serif;
        }
    </style>
</head>
<body>
    <h2>Enter Booking Details</h2>

    <form method="get" asp-action="FilteredDetails" asp-controller="Booking">
        <div class="form-group">
            <label for="bookingType">Booking Type:</label>
            <select class="form-control" id="bookingType" name="bookingType" required>
                <option value="">Select Booking Type</option>
                <option value="Flight">Flight</option>
                <option value="Car">Car</option>
                <option value="Hotel">Hotel</option>
            </select>
        </div>
    
            <div class="form-group">
                <label for="bookingId">Booking ID:</label>
                <input type="text" class="form-control" id="bookingId" name="bookingId" required />
            </div>
        
        <br />
        <button type="submit" class="btn btn-primary">Get Details</button>
        <a href="javascript:history.back()" class="btn btn-secondary">Go Back</a>
    </form>
</body>
</html>
