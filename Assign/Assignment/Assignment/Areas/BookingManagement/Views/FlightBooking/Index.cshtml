@using Assignment.Areas.BookingManagement.Models;
@using Assignment.Areas.ServiceManagement.Models;
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@model List<Flight>

@{
    ViewData["Title"] = "Flight Booking";
}

<h2>Flight Booking</h2>
@if (Model.Any())
{


    <form class="d-flex"  asp-controller="FlightBooking" asp-action="GeneralSearch" method="get">
        <input class="form-control" type="text" placeholder="Search" name="searchString" />
        <select class="form-control btn btn-secondary dropdown-toggle" name="searchType">
            <option value="ArrivingCity">Arriving City</option>
            <option value="Destination">Destination</option>
            <option value="Airlines">Airlines</option>
        </select>
        <button class="btn btn-outline-success" type="submit">Search</button>
    </form>


    <form asp-action="Create" method="get">
        <div class="form-group">
            <label for="departureCity">Departure City:</label>
            <select class="form-control" id="departureCity" name="departureCity">
                @foreach (var departureCity in Model.Select(f => f.departure).Distinct())
                {
                    <option>@departureCity</option>
                }
            </select>
        </div>


        <div class="form-group">
            <label for="arrivalCity">Arrival City:</label>
            <select class="form-control" id="arrivalCity" name="arrivalCity">
                @foreach (var arrivalCity in Model.Select(f => f.arrival).Distinct())
                {
                    <option>@arrivalCity</option>
                }
            </select>
    </div>

    <div class="form-group">
        <label for="date">Date:</label>
        <input type="date" class="form-control" id="date" name="date" min="@DateTime.Now.ToString("yyyy-MM-dd")" required>
    </div>

    <br />

    <button type="submit" class="btn btn-primary">Search</button>
        <a asp-action="Index" asp-controller="Booking" class="btn btn-secondary">Cancel</a>

</form>

}
else
{
    <p>No Flight Available.</p>
    <br />
    <div id="detailsSection" style="display: none;"></div>

}



