@using Assignment.Areas.BookingManagement.Models;
@using Assignment.Areas.ServiceManagement.Models;
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@model Flight

<!DOCTYPE html>
<html>
<head>
    <title>Edit Flight</title>
</head>
<body>
    <h2>Edit Flight: @Model.id @Model.arrival --> @Model.departure     : @Model.depTime</h2>

    <form asp-action="Edit" asp-controller="Flight" method="post">
        <input type="hidden" asp-for="id" />
        <input type="hidden" asp-for="arrival" />
        <input type="hidden" asp-for="departure" />
        <input type="hidden" asp-for="arrTime" />
        <input type="hidden" asp-for="depTime" />
        <input type="hidden" asp-for="numPassanger" />
        <input type="hidden" asp-for="airline" />







        <div class="form-group">
            <label asp-for="price">Price:</label>
            <input asp-for="price" class="form-control" />
        </div>

        <div class="form-group">
            <label asp-for="maxPassanger">Max Passenger:</label>
            <input asp-for="maxPassanger" class="form-control" />
        </div>

       

        <br />

        <button type="submit" class="btn btn-primary">Save</button>
        <a href="javascript:history.back()" class="btn btn-secondary">Cancel</a>
    </form>
</body>
</html>
