@using Assignment.Areas.BookingManagement.Models;
@using Assignment.Areas.ServiceManagement.Models;
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@model List<Car>

<!DOCTYPE html>
<html>
<head>
    <title>List of Cars</title>
</head>
<body>
    <h2>List of Cars</h2>

    @if (Model != null && Model.Any())
    {
        <table class="table">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Model</th>
                    <th>Type</th>
                    <th>Price</th>
                    <th>Rental Companies</th>
                    <th>Location</th>
                    <th>Availability</th>
                    <th>Available From</th>
                    <th></th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var car in Model)
                {
                    <tr>
                        <td>@car.id</td>
                        <td>@car.model</td>
                        <td>@car.type</td>
                        <td>$@car.price</td>
                        <td>@car.rentalCompanies</td>
                        <td>@car.location</td>
                        <td>@(car.isAvailable ? "Yes" : "No")</td>
                        <td>@(car.availableFrom.ToString("yyyy-MM-dd HH:mm") )</td>
                        <td>
                            <a class="btn btn-primary" href="@Url.Action("Edit", "Car", new { id = car.id })">Edit</a>
                        </td>
                        <td>
                            <form asp-action="DeleteCar" asp-controller="Car" method="post" onsubmit="return confirm('Are you sure you want to delete this car?');">
                                <input type="hidden" name="id" value="@car.id" />
                                <button type="submit" class="btn btn-danger">Delete</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <p>No cars available.</p>
    }

    <a href="javascript:history.back()" class="btn btn-secondary">Go Back</a>
</body>
</html>
