@using Assignment.Areas.BookingManagement.Models;
@using Assignment.Areas.ServiceManagement.Models;
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@model Car

@{
    ViewData["Title"] = "Create Car";
}

<!DOCTYPE html>
<html>
<head>
    <title>Create Car</title>
    <style>
        h2 {
            margin-top: 10px;
            margin-bottom: 20px;
            font-size: 4em;
            font-family: 'Merriweather', serif;
        }

        form {
            text-align: center;
            width: 50%;
            margin: auto;
        }

        .form-group {
            margin-bottom: 20px;
            text-align: left;
        }

        input[type="submit"],
        a.btn {
            margin-top: 20px;
        }
    </style>
</head>
<body>
    <h2>Add Car</h2>

    <form asp-action="Create" method="post">

        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div class="form-group">
            <label asp-for="model" class="control-label"></label>
            <input asp-for="model" class="form-control" />
            <span asp-validation-for="model" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="type" class="control-label"></label>
            <input asp-for="type" class="form-control" />
            <span asp-validation-for="type" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="price" class="control-label"></label>
            <div class="input-group">
                <span class="input-group-addon">$ </span>
                <input asp-for="price" class="form-control" type="number" />
            </div>
            <span asp-validation-for="price" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="rentalCompanies" class="control-label"></label>
            <input asp-for="rentalCompanies" class="form-control" />
            <span asp-validation-for="rentalCompanies" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="location" class="control-label"></label>
            <input asp-for="location" class="form-control" />
            <span asp-validation-for="location" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="isAvailable" class="control-label"></label>
            <input asp-for="isAvailable" type="checkbox" />
            <span asp-validation-for="isAvailable" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="availableFrom" class="control-label"></label>
            <input asp-for="availableFrom" class="form-control" type="datetime-local" min="@DateTime.Now.ToString("yyyy-MM-ddTHH:mm")" />
            <span asp-validation-for="availableFrom" class="text-danger"></span>
        </div>

        <div class="form-group">
            <input type="submit" value="Add Car" class="btn btn-primary" />
            <a asp-action="Index" class="btn btn-warning">Cancel</a>
        </div>
    </form>
</body>
</html>
