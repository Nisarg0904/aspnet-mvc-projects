@using Assignment.Areas.BookingManagement.Models;
@using Assignment.Areas.ServiceManagement.Models;
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@model Hotel

<!DOCTYPE html>
<html>
<head>
    <title>Edit Hotel</title>
</head>
<body>
    <h2>Edit Hotel : @Model.name</h2>
    

    <form asp-action="Edit" asp-controller="Hotel" method="post">
        <input type="hidden" asp-for="id" />
        <input type="hidden" asp-for="name" />
        <input type="hidden" asp-for="city" />
        <input type="hidden" asp-for="location" />


        <div class="form-group">
            <label asp-for="price">Price:</label>
            <input asp-for="price" class="form-control" />
        </div>

        <div class="form-group">
            <label asp-for="numRooms">Number of Rooms:</label>
            <input asp-for="numRooms" class="form-control" />
        </div>

        <div class="form-group">
            <label asp-for="amenities">Amenities:</label>
            <input asp-for="amenities" class="form-control" />
        </div>
        <br />

        <button type="submit" class="btn btn-primary">Save</button>
        <a href="javascript:history.back()" class="btn btn-secondary">Cancel</a>
    </form>
</body>
</html>
@Html.ValidationSummary()

