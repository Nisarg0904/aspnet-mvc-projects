@model Car

<!DOCTYPE html>
<html>
<head>
    <title>Edit Car: @Model.model</title>
</head>
<body>
    <h2>Edit Car: @Model.model</h2>

    <form asp-action="EditCar" asp-controller="Car" method="post">
        <input type="hidden" asp-for="id" />
        <input type="hidden" asp-for="model" />
        <input type="hidden" asp-for="type" />
        <input type="hidden" asp-for="rentalCompanies" />



        <div class="form-group">
            <label asp-for="price">Price:</label>
            <input asp-for="price" class="form-control" />
        </div>

        <div class="form-group">
            <label asp-for="location">Location:</label>
            <input asp-for="location" class="form-control" />
        </div>

        <div class="form-group">
            <label>Is Available:</label><br />
            <label>
                <input type="radio" asp-for="isAvailable" value="true" /> Yes
            </label>
            <label>
                <input type="radio" asp-for="isAvailable" value="false" /> No
            </label>
        </div>


        <div class="form-group">
            <label asp-for="availableFrom">Available From:</label>
            <input asp-for="availableFrom" type="datetime-local" class="form-control" />
        </div>

        <br />

        <button type="submit" class="btn btn-primary">Save</button>
        <a href="javascript:history.back()" class="btn btn-secondary">Cancel</a>
    </form>
</body>
</html>
