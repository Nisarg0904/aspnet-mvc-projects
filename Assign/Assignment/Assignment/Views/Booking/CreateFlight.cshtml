@model List<Flight>

@{
    ViewData["Title"] = "Flight Booking";
}

<h2>Flight Booking</h2>

<form asp-action="SearchFlights" method="get">
    <div class="form-group">
        <label for="departureCity">Departure City:</label>
        <select class="form-control" id="departureCity" name="departureCity">
            @foreach (var departureCity in Model.Select(f => f.departure).Distinct())
            {
                <option>@departureCity</option>
            }
        </select>
    </div>
   

    <div class="form-group">
        <label for="arrivalCity">Arrival City:</label>
        <select class="form-control" id="arrivalCity" name="arrivalCity">
            @foreach (var arrivalCity in Model.Select(f => f.arrival).Distinct())
            {
                <option>@arrivalCity</option>
            }
        </select>
    </div>

    <div class="form-group">
        <label for="date">Date:</label>
        <input type="date" class="form-control" id="date" name="date" required>
    </div>
    <br />

    <button type="submit" class="btn btn-primary">Search</button>
</form>

@if (Model != null && Model.Count > 0)
{
    <h3>Available Flights</h3>
    <table class="table">
        <thead>
            <tr>
                <th>Departure City</th>
                <th>Arrival City</th>
                <th>Departure Time</th>
                <th>Arrival Time</th>
                <th>Price</th>
                <th>Airline</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var flight in Model)
            {
                if (flight.numPassanger < flight.maxPassanger)
                {
                    <tr>
                        <td>@flight.departure</td>
                        <td>@flight.arrival</td>
                        <td>@flight.depTime.ToString("yyyy-MM-dd HH:mm")</td>
                        <td>@flight.arrTime.ToString("yyyy-MM-dd HH:mm")</td>
                        <td>$@flight.price</td>
                        <td>@flight.airline</td>
                        <td>
                            <a class="btn btn-info" href="#" onclick="viewDetails(@flight.id)">View Details</a>
                            <a class="btn btn-success" href="#" onclick="bookFlight(@flight.id)">Book</a>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
}

<div id="detailsSection" style="display: none;"></div>
@section Scripts {
    <script>
        $(document).ready(function () {
            $('#searchForm').submit(function (e) {
                e.preventDefault();

                var form = $(this);
                var url = form.attr('action');
                var formData = form.serialize();

                // AJAX call to search flights with filters
                $.get(url, formData, function (data) {
                    $('#flightResults').html(data);
                    $('#flightResults').show();
                });
            });
        });

        function bookFlight(id, price) {
            var url = '@Url.Action("CreateFlightBooking", "Booking")';
            if (confirm("Are you sure you want to book this flight?")) {
                $.ajax({
                    url: url,
                    type: 'POST',
                    data: { id: id, price: price },
                    success: function (data) {
                        alert("Flight booked successfully!");
                    },
                    error: function () {
                        alert("An error occurred while booking the flight.");
                    }
                });
            }
        }
    </script>

}
