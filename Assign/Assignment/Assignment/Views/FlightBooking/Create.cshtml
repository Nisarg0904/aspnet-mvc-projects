@model List<Flight>

@{
    ViewData["Title"] = "List of Flights";
}

<h2>List of Flights</h2>

@if (Model != null && Model.Any())
{
    <table class="table">
        <thead>
            <tr>
                <th>Departure City</th>
                <th>Arrival City</th>
                <th>Departure Date & Time</th>
                <th>Arrival Date & Time</th>
                <th>Price</th>
                <th>Journey Time</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var flight in Model)
            {
                <tr>
                    <td>@flight.departure</td>
                    <td>@flight.arrival</td>
                    <td>@flight.depTime.ToString("yyyy-MM-dd HH:mm")</td>
                    <td>@flight.arrTime.ToString("yyyy-MM-dd HH:mm")</td>
                    <td>$@flight.price</td>
                    <td>@(flight.arrTime - flight.depTime)</td>
                    <td>
                        <form asp-action="ConfirmCreate" asp-route-flightId="@flight.id">
                            <button type="submit" class="btn btn-primary">Book It</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
    <br />

    <a href="javascript:history.back()" class="btn btn-secondary">Go Back</a>

}
else
{
    <p>No flights available.</p>
    <br />
    <a href="javascript:history.back()" class="btn btn-secondary">Go Back</a>

}

