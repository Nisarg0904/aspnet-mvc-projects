@model List<Hotel>

<!DOCTYPE html>
<html>
<head>
    <title>List of Hotels</title>
</head>
<body>
    <h2>List of Hotels</h2>

    @if (Model != null && Model.Any())
    {
        <table class="table">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Name</th>
                    <th>City</th>
                    <th>Location</th>
                    <th>Price</th>
                    <th>Number of Rooms</th>
                    <th>Amenities</th>
                    <th></th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var hotel in Model)
                {
                    <tr>
                        <td>@hotel.id</td>
                        <td>@hotel.name</td>
                        <td>@hotel.city</td>
                        <td>@hotel.location</td>
                        <td>$@hotel.price</td>
                        <td>@hotel.numRooms</td>
                        <td>@hotel.amenities</td>
                        <td>
                            <a class="btn btn-primary" href="@Url.Action("Edit", "Hotel", new { id = hotel.id })">Edit</a>
                        </td>
                        <td>
                            <form asp-action="DeleteHotel" asp-controller="Hotel" method="post" onsubmit="return confirm('Are you sure you want to delete this hotel?');">
                                <input type="hidden" name="id" value="@hotel.id" />
                                <button type="submit" class="btn btn-danger">Delete</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <p>No hotels available.</p>
    }

    <a href="javascript:history.back()" class="btn btn-secondary">Go Back</a>
</body>
</html>
