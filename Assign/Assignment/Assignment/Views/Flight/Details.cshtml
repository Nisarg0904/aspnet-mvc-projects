@model List<Flight>

<!DOCTYPE html>
<html>
<head>
    <title>List of Flights</title>
</head>
<body>
    <h2>List of Flights</h2>

    @if (Model != null && Model.Any())
    {
        <table class="table">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Departure</th>
                    <th>Arrival</th>
                    <th>Departure Time</th>
                    <th>Arrival Time</th>
                    <th>Airline</th>
                    <th>Price</th>
                    <th>Max Passenger</th>
                    <th>Num Passenger</th>
                    <th></th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var flight in Model)
                {
                    <tr>
                        <td>@flight.id</td>
                        <td>@flight.departure</td>
                        <td>@flight.arrival</td>
                        <td>@flight.depTime.ToString("yyyy-MM-dd HH:mm")</td>
                        <td>@flight.arrTime.ToString("yyyy-MM-dd HH:mm")</td>
                        <td>@flight.airline</td>
                        <td>$@flight.price</td>
                        <td>@flight.maxPassanger</td>
                        <td>@flight.numPassanger</td>
                        <td>
                            <a class="btn btn-primary" href="@Url.Action("EditFlight", "YourControllerName", new { id = flight.id })">Edit</a>
                        </td>
                        <td>
                            <form asp-action="DeleteFlight" asp-controller="Flight" method="post" onsubmit="return confirm('Are you sure you want to delete this flight?');">
                                <input type="hidden" name="id" value="@flight.id" />
                                <button type="submit" class="btn btn-danger">Delete</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <p>No flights available.</p>
    }

    <a href="javascript:history.back()" class="btn btn-secondary">Go Back</a>
</body>
</html>
