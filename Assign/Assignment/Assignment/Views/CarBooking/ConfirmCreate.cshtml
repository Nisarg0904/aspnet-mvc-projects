@model List<Car>

@{
    ViewData["Title"] = "Car Details";
}

<h2>Car Details</h2>

@if (Model != null && Model.Any())
{
    @foreach (var car in Model)
    {
        <div class="card">
            <div class="card-body">
                <h5 class="card-title">@car.model</h5>
                <p class="card-text">Type: @car.type</p>
                <p class="card-text">Price: $@car.price</p>
                <p class="card-text">Rental Company: @car.rentalCompanies</p>
                <p class="card-text">Location: @car.location</p>
            </div>
        </div>

        <div class="mt-3">
            <form method="get" asp-action="Confirmation" asp-controller="CarBooking">
                <input type="hidden" name="carId" value="@car.id" />
                <div class="form-group">
                    <label for="pickupDate">Pickup Date:</label>
                    <input type="date" class="form-control" id="pickupDate" name="pickupDate" min="@car.availableFrom.ToString("yyyy-MM-dd")" required />
                </div>

                <div class="form-group">
                    <label for="returnDate">Return Date:</label>
                    <input type="date" class="form-control" id="returnDate" name="returnDate" min="@car.availableFrom.ToString("yyyy-MM-dd")" required  />
                </div>

          

                <br />
                <button type="submit" class="btn btn-primary">Confirm Booking</button>
            </form>
        </div>
    }
}
else
{
    <p>No car selected.</p>
}
